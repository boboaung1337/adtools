    -s, --silent    Suppress all output except errors

EXAMPLES:
    # Auto-detect network and discover domains
    crossrealms

    # Scan specific network range
    crossrealms 192.168.1.0/24

    # Verbose mode with custom output file
    crossrealms -v -o ./krb5.conf 10.0.0.0/24

    # Silent mode
    crossrealms -s 172.16.0.0/16

"""
    print(help_text)


def main():
    """Main entry point with argument parsing"""
    parser = argparse.ArgumentParser(
        description='Universal Cross-Forest Kerberos Generator - Discover domains and generate krb5.conf',
        add_help=False  # We'll handle help manually for custom formatting
    )
    
    parser.add_argument(
        'network',
        nargs='?',
        help='Network range to scan (e.g., 192.168.1.0/24). If not specified, auto-detection will be attempted.'
    )
    
    parser.add_argument(
        '-h', '--help',
        action='store_true',
        help='Show this help message and exit'
    )
    
    parser.add_argument(
        '-v', '--verbose',
        action='store_true',
        help='Enable verbose output with detailed discovery information'
    )
    
    parser.add_argument(
        '-o', '--output',
        metavar='FILE',
        help='Save configuration to specified file (default: /etc/krb5.conf)'
    )
    
    parser.add_argument(
        '-s', '--silent',
        action='store_true',
        help='Suppress all output except errors'
    )
    
    args = parser.parse_args()
    
    # Show help if requested
    if args.help:
        show_help()
        sys.exit(0)
    
    # Create and run generator
    generator = UniversalKrb5Generator(
        network=args.network,
        verbose=args.verbose
    )
    
    # Override save path if specified
    if args.output:
        generator.save_config(args.output)
    
    # Run the generator
    generator.run()

if __name__ == "__main__":
    main()