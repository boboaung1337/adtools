#!/bin/bash
set -e

SLIVER_MINISIGN_PUB_KEY="RWTZPg959v3b7tLG7VzKHRB1/QT+d3c71Uzetfa44qAoX5rH7mGoQTTR"

# ---------------------------------------------------------------------------
# User detection — only trust SUDO_USER when genuinely running under sudo
# ---------------------------------------------------------------------------
detect_target_user() {
    if [[ "$(id -u)" -ne 0 ]]; then
        echo "$(id -un)"
        return
    fi

    if [[ -n "$SUDO_USER" && "$SUDO_USER" != "root" \
          && -n "$SUDO_UID" && -n "$SUDO_GID" ]]; then
        if ps -o comm= -p "$PPID" 2>/dev/null | grep -q '^sudo$'; then
            echo "$SUDO_USER"
            return
        fi
    fi

    echo "root"
}

TARGET_USER="$(detect_target_user)"
TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
TARGET_HOME="${TARGET_HOME:-$HOME}"
TARGET_UID="$(id -u "$TARGET_USER")"
TARGET_GID="$(id -g "$TARGET_USER")"
TARGET_SHELL="$(getent passwd "$TARGET_USER" | cut -d: -f7)"
TARGET_SHELL_NAME="$(basename "${TARGET_SHELL:-/bin/bash}")"

INSTALL_DIR="$TARGET_HOME/.local/bin"
CONFIG_DIR="$TARGET_HOME/.sliver-client"

echo "Installing Sliver for user : $TARGET_USER"
echo "  home                     : $TARGET_HOME"
echo "  login shell              : ${TARGET_SHELL:-unknown}"

mkdir -p "$INSTALL_DIR" "$CONFIG_DIR/configs"

# ---------------------------------------------------------------------------
# Private per-user working directory (fixes root/kali /tmp permission clash)
# ---------------------------------------------------------------------------
WORK_DIR="$(mktemp -d -t sliver-install.XXXXXXXX)"
cleanup() {
    # Only remove files we own; ignore errors
    rm -rf "$WORK_DIR" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

echo "Working directory        : $WORK_DIR"
cd "$WORK_DIR"

# ---------------------------------------------------------------------------
# Check for minisign
# ---------------------------------------------------------------------------
MINISIGN_PKG=(minisign)
if command -v minisign &> /dev/null; then
    MINISIGN_PKG=()
fi

# ---------------------------------------------------------------------------
# Install dependencies (only if needed)
# ---------------------------------------------------------------------------
if command -v apt-get &> /dev/null; then
    echo "Installing dependencies using apt..."
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -yqq \
        "${MINISIGN_PKG[@]}" curl build-essential git
elif command -v yum &> /dev/null; then
    echo "Installing dependencies using yum..."
    sudo yum -y install "${MINISIGN_PKG[@]}" curl make git
elif command -v pacman &>/dev/null; then
    echo "Installing dependencies using pacman..."
    if [[ ${#MINISIGN_PKG[@]} -gt 0 ]]; then
        sudo pacman --noconfirm -S "${MINISIGN_PKG[@]}"
    fi
else
    echo "Unsupported OS, exiting"
    exit 1
fi

# ---------------------------------------------------------------------------
# Verify necessary tools
# ---------------------------------------------------------------------------
for cmd in curl awk minisign; do
    if ! command -v "$cmd" &> /dev/null; then
        echo "$cmd could not be found, installing..."
        if command -v apt-get &> /dev/null; then
            sudo apt-get install -yqq "$cmd"
        elif command -v yum &> /dev/null; then
            sudo yum -y install "$cmd"
        elif command -v pacman &>/dev/null; then
            sudo pacman --noconfirm -S "$cmd"
        fi
    fi
done

echo "Using Minisign public key..."

# ---------------------------------------------------------------------------
# Stop existing Sliver processes for the target user
# ---------------------------------------------------------------------------
stop_existing_sliver_daemon() {
    if pgrep -u "$TARGET_USER" -f "sliver-server daemon" > /dev/null 2>&1; then
        echo "Stopping running Sliver daemon for $TARGET_USER..."
        pkill -u "$TARGET_USER" -f "sliver-server daemon" || true
    fi
}

# ---------------------------------------------------------------------------
# Determine architecture
# ---------------------------------------------------------------------------
ARCH="$(uname -m)"
case "$ARCH" in
    x86_64|amd64)
        SLIVER_PLATFORM="linux-amd64"
        ;;
    aarch64|arm64)
        SLIVER_PLATFORM="linux-arm64"
        ;;
    *)
        echo "Unsupported architecture: $ARCH"
        exit 1
        ;;
esac

# ---------------------------------------------------------------------------
# Fetch latest Sliver release URLs
# ---------------------------------------------------------------------------
echo "Fetching latest Sliver release URLs..."
ARTIFACTS=$(curl -s "https://api.github.com/repos/BishopFox/sliver/releases/latest" \
    | awk -F '"' '/browser_download_url/{print $4}')

SLIVER_SERVER="sliver-server_${SLIVER_PLATFORM}"
SLIVER_CLIENT="sliver-client_${SLIVER_PLATFORM}"

for URL in $ARTIFACTS
do
    if [[ "$URL" == *"$SLIVER_SERVER"* ]]; then
        echo "Downloading $URL"
        curl -L "$URL" --output "$(basename "$URL")"
    fi
    if [[ "$URL" == *"$SLIVER_CLIENT"* ]]; then
        echo "Downloading $URL"
        curl -L "$URL" --output "$(basename "$URL")"
    fi
done

# ---------------------------------------------------------------------------
# Make sure required files exist before verifying
# ---------------------------------------------------------------------------
for f in "$SLIVER_SERVER" "$SLIVER_SERVER.minisig" \
         "$SLIVER_CLIENT" "$SLIVER_CLIENT.minisig"; do
    if [[ ! -f "$WORK_DIR/$f" ]]; then
        echo "ERROR: Missing $WORK_DIR/$f"
        exit 2
    fi
done

# ---------------------------------------------------------------------------
# Signature verification
# ---------------------------------------------------------------------------
echo "Verifying signatures ..."
minisign -Vm "$WORK_DIR/$SLIVER_SERVER" -x "$WORK_DIR/$SLIVER_SERVER.minisig" -P "$SLIVER_MINISIGN_PUB_KEY"
minisign -Vm "$WORK_DIR/$SLIVER_CLIENT" -x "$WORK_DIR/$SLIVER_CLIENT.minisig" -P "$SLIVER_MINISIGN_PUB_KEY"

stop_existing_sliver_daemon

# ---------------------------------------------------------------------------
# Install Sliver server
# ---------------------------------------------------------------------------
if test -f "$WORK_DIR/$SLIVER_SERVER"; then
    echo "Moving Sliver server executable to $INSTALL_DIR/sliver-server..."
    mv "$WORK_DIR/$SLIVER_SERVER" "$INSTALL_DIR/sliver-server"
    chmod 755 "$INSTALL_DIR/sliver-server"

    echo "Unpacking Sliver server..."
    "$INSTALL_DIR/sliver-server" unpack --force
else
    echo "ERROR: Sliver server not found"
    exit 3
fi

# ---------------------------------------------------------------------------
# Install Sliver client
# ---------------------------------------------------------------------------
if test -f "$WORK_DIR/$SLIVER_CLIENT"; then
    echo "Moving Sliver client executable to $INSTALL_DIR/sliver-client..."
    mv "$WORK_DIR/$SLIVER_CLIENT" "$INSTALL_DIR/sliver-client"
    chmod 755 "$INSTALL_DIR/sliver-client"

    echo "Creating symbolic link for sliver-client at $INSTALL_DIR/sliver..."
    ln -sf "$INSTALL_DIR/sliver-client" "$INSTALL_DIR/sliver"
    chmod 755 "$INSTALL_DIR/sliver"
else
    echo "ERROR: Sliver client not found"
    exit 3
fi

# ---------------------------------------------------------------------------
# Generate operator configs for the target user
# ---------------------------------------------------------------------------
echo "Generating operator configs for $TARGET_USER..."
"$INSTALL_DIR/sliver-server" operator \
    --name "$TARGET_USER" \
    --lhost 127.0.0.1 \
    --permissions all \
    --save "$CONFIG_DIR/configs"

# ---------------------------------------------------------------------------
# Fix ownership only if running as root for another user
# ---------------------------------------------------------------------------
if [[ "$(id -u)" -eq 0 && "$TARGET_USER" != "root" ]]; then
    echo "Setting ownership of $CONFIG_DIR and $INSTALL_DIR to $TARGET_USER..."
    chown -R "$TARGET_UID:$TARGET_GID" "$CONFIG_DIR"
    chown -R "$TARGET_UID:$TARGET_GID" "$INSTALL_DIR"
fi

# ---------------------------------------------------------------------------
# Add to PATH in the target user's login-shell rc file
# ---------------------------------------------------------------------------
PATH_LINE='export PATH="$HOME/.local/bin:$PATH"'

add_to_rc() {
    local rc="$1"
    [[ -n "$rc" ]] || return 0
    if [[ ! -f "$rc" ]]; then
        touch "$rc"
        if [[ "$(id -u)" -eq 0 && "$TARGET_USER" != "root" ]]; then
            chown "$TARGET_UID:$TARGET_GID" "$rc"
        fi
    fi
    if ! grep -qF 'HOME/.local/bin' "$rc" 2>/dev/null; then
        echo "Adding PATH entry to $rc"
        printf '\n# Added by Sliver installer\n%s\n' "$PATH_LINE" >> "$rc"
        if [[ "$(id -u)" -eq 0 && "$TARGET_USER" != "root" ]]; then
            chown "$TARGET_UID:$TARGET_GID" "$rc"
        fi
    else
        echo "PATH entry already present in $rc"
    fi
}

case "$TARGET_SHELL_NAME" in
    zsh)
        add_to_rc "$TARGET_HOME/.zshrc"
        add_to_rc "$TARGET_HOME/.zprofile"
        ;;
    bash)
        add_to_rc "$TARGET_HOME/.bashrc"
        add_to_rc "$TARGET_HOME/.profile"
        ;;
    *)
        add_to_rc "$TARGET_HOME/.profile"
        add_to_rc "$TARGET_HOME/.bashrc"
        add_to_rc "$TARGET_HOME/.zshrc"
        ;;
esac

# Make the current shell aware of the new PATH too
if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    export PATH="$INSTALL_DIR:$PATH"
fi

# ---------------------------------------------------------------------------
# Warn about sudo secure_path
# ---------------------------------------------------------------------------
if sudo -n grep -q '^Defaults.*secure_path' /etc/sudoers 2>/dev/null; then
    echo ""
    echo "NOTE: sudo uses a 'secure_path' which does NOT include $INSTALL_DIR."
    echo "      Running 'sudo sliver-server' may not find the binary."
    echo "      Use the full path:  sudo $INSTALL_DIR/sliver-server"
fi

echo ""
echo "============================================"
echo "✅ Sliver installation complete!"
echo "============================================"
